# Copy to .env and fill in the values. .env is not committed.

# PostgreSQL container (docker compose)
POSTGRES_USER=wms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wms

# Used when the backend runs outside Docker; must match the values above.
# In docker compose it is overridden to point at the "db" service.
DATABASE_URL=postgresql+asyncpg://wms:change-me@localhost:5432/wms

# Administrator account, created or updated by scripts/create_admin.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Long random string, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
